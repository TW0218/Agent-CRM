<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tw0218.agent-crm.watchplayers</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/takuwatanabe/Desktop/MMS/アプリ開発/agent-crm/scripts/update_watch_players.py</string>
    </array>

    <!-- 毎週月曜 06:00（ローカル時刻）。実行時にMacがスリープ中なら復帰後に実行される。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/takuwatanabe/Library/Logs/agent-crm-watchplayers.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/takuwatanabe/Library/Logs/agent-crm-watchplayers.log</string>
</dict>
</plist>
